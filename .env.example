# Example environment variables for local development
# Copy to .env and fill values for local development. Do NOT commit real secrets.

# Database connection (SQLAlchemy URL)
# Examples:
# SQLite (local dev): sqlite:///./pavedpath.db
# Postgres (local): postgresql+psycopg://postgres:postgres@localhost:5432/pavedpath
DATABASE_URL=

# App environment: development | production
APP_ENV=development

# Logging level: debug | info | warning | error
LOG_LEVEL=info

# Optional Postgres settings for docker-compose/local scripts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pavedpath
